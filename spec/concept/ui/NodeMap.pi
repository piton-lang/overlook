from ./Editor import Editor

export anchor NodeMap:
    pitch:
        An infinite canvas of interconnected nodes representing the folders and
        files of a specbase, with connections drawn between connected anchors
        and symbols.

        Unreached files and symbols will also be displayed.

    interaction:
        You can click and drag nodes around.

        You can select nodes.

        You can focus on a node to see its connections.

    focusMode:
        When you focus on a node, all other nodes disappear and the nodes
        rearrange.

    edit:
        When a single node is selected, a resiable sidebar will appear with the
        @{Editor}
